<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Marvin — Your Photos, Your Cartoon World</title>
  <!-- Google Fonts & Lucide Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --primary: #8b5cf6;
      --primary-hover: #7c3aed;
      --accent-pink: #ec4899;
      --accent-cyan: #06b6d4;
      --accent-yellow: #f59e0b;
      --bg-dark: #09090b;
      --surface-dark: #12131a;
      --surface-card: rgba(26, 27, 38, 0.75);
      --border-color: rgba(255, 255, 255, 0.1);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 15% 15%, rgba(139, 92, 246, 0.18) 0%, transparent 40%),
        radial-gradient(circle at 85% 85%, rgba(236, 72, 153, 0.15) 0%, transparent 40%),
        radial-gradient(circle at 50% 50%, rgba(6, 182, 212, 0.08) 0%, transparent 50%);
      background-attachment: fixed;
    }

    /* Container & Layout */
    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 1.5rem 1rem 4rem 1rem;
    }

    /* Header */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 0 2rem 0;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: inherit;
    }

    .brand-icon {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, var(--primary), var(--accent-pink));
      border-radius: 14px;
      display: grid;
      place-items: center;
      box-shadow: 0 4px 20px rgba(139, 92, 246, 0.4);
    }

    .brand-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.6rem;
      letter-spacing: -0.5px;
      background: linear-gradient(to right, #fff, #cbd5e1);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .badge {
      font-size: 0.7rem;
      text-transform: uppercase;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 9999px;
      background: rgba(139, 92, 246, 0.2);
      border: 1px solid rgba(139, 92, 246, 0.4);
      color: #c4b5fd;
    }

    .api-btn {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      padding: 0.5rem 1rem;
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .api-btn:hover {
      background: rgba(255, 255, 255, 0.12);
      color: var(--text-main);
    }

    /* Hero */
    .hero {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .tagline-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 1rem;
      border-radius: 999px;
      background: rgba(236, 72, 153, 0.12);
      border: 1px solid rgba(236, 72, 153, 0.3);
      color: #f472b6;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }

    .hero h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 2.75rem;
      line-height: 1.15;
      margin-bottom: 0.75rem;
      letter-spacing: -0.03em;
    }

    .hero h1 span {
      background: linear-gradient(135deg, #a78bfa, #f472b6, #38bdf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: var(--text-muted);
      font-size: 1.05rem;
      max-width: 580px;
      margin: 0 auto;
    }

    /* Studio Card */
    .studio-card {
      background: var(--surface-card);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-color);
      border-radius: 24px;
      padding: 1.75rem;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
    }

    /* Upload Area */
    .drop-zone {
      border: 2px dashed rgba(139, 92, 246, 0.4);
      background: rgba(139, 92, 246, 0.03);
      border-radius: 18px;
      padding: 2.5rem 1.5rem;
      text-align: center;
      cursor: pointer;
      position: relative;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 230px;
    }

    .drop-zone:hover, .drop-zone.dragover {
      border-color: var(--primary);
      background: rgba(139, 92, 246, 0.08);
      transform: translateY(-2px);
    }

    .upload-icon-circle {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: rgba(139, 92, 246, 0.15);
      color: #a78bfa;
      display: grid;
      place-items: center;
      margin-bottom: 1rem;
    }

    .file-input {
      display: none;
    }

    .sample-strip {
      margin-top: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      font-size: 0.825rem;
      color: var(--text-muted);
    }

    .sample-chip {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 0.25rem 0.75rem;
      border-radius: 99px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .sample-chip:hover {
      background: rgba(255, 255, 255, 0.15);
    }

    /* Style Selector */
    .section-label {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-main);
      margin: 1.75rem 0 0.85rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .styles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }

    .style-card {
      background: rgba(255, 255, 255, 0.03);
      border: 2px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 1rem;
      cursor: pointer;
      position: relative;
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .style-card:hover {
      background: rgba(255, 255, 255, 0.06);
      transform: translateY(-2px);
    }

    .style-card.active {
      border-color: var(--primary);
      background: rgba(139, 92, 246, 0.12);
      box-shadow: 0 0 20px rgba(139, 92, 246, 0.25);
    }

    .style-card .style-icon {
      font-size: 1.8rem;
    }

    .style-title {
      font-weight: 700;
      font-size: 1rem;
    }

    .style-desc {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.35;
    }

    .check-mark {
      position: absolute;
      top: 10px;
      right: 10px;
      color: var(--primary);
      opacity: 0;
      transition: opacity 0.2s;
    }

    .style-card.active .check-mark {
      opacity: 1;
    }

    /* Primary Action Button */
    .btn-transform {
      width: 100%;
      margin-top: 1.75rem;
      background: linear-gradient(135deg, #8b5cf6, #ec4899);
      color: white;
      font-weight: 700;
      font-size: 1.05rem;
      padding: 1.1rem;
      border-radius: 16px;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      box-shadow: 0 10px 25px rgba(139, 92, 246, 0.35);
      transition: all 0.25s ease;
    }

    .btn-transform:hover:not(:disabled) {
      box-shadow: 0 12px 30px rgba(236, 72, 153, 0.45);
      transform: translateY(-2px);
      filter: brightness(1.08);
    }

    .btn-transform:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      filter: grayscale(0.5);
    }

    /* Loading Overlay */
    .loading-pane {
      display: none;
      text-align: center;
      padding: 2.5rem 1rem;
    }

    .loading-pane.show {
      display: block;
    }

    .spinner-box {
      width: 60px;
      height: 60px;
      border: 4px solid rgba(139, 92, 246, 0.2);
      border-top-color: var(--primary);
      border-right-color: var(--accent-pink);
      border-radius: 50%;
      margin: 0 auto 1.25rem;
      animation: spin 0.9s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
    }

    @keyframes spin {
      100% { transform: rotate(360deg); }
    }

    .loading-status {
      font-weight: 600;
      font-size: 1.1rem;
      margin-bottom: 0.35rem;
    }

    .loading-step {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* Comparison Area */
    .result-pane {
      display: none;
      margin-top: 2rem;
    }

    .result-pane.show {
      display: block;
    }

    .comparison-container {
      position: relative;
      width: 100%;
      max-width: 650px;
      margin: 0 auto;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5);
      background: #000;
      user-select: none;
      aspect-ratio: 1 / 1;
    }

    .comparison-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .img-before-wrap {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 50%;
      overflow: hidden;
      z-index: 2;
    }

    .img-before-wrap img {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      max-width: none;
      object-fit: cover;
    }

    .slider-handle {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 4px;
      background: #ffffff;
      box-shadow: 0 0 12px rgba(0, 0, 0, 0.8);
      z-index: 10;
      cursor: ew-resize;
      transform: translateX(-50%);
    }

    .slider-button {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #ffffff;
      color: #000000;
      display: grid;
      place-items: center;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
      font-size: 14px;
      font-weight: 800;
    }

    .tag-label {
      position: absolute;
      bottom: 16px;
      padding: 6px 14px;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #ffffff;
      z-index: 5;
    }

    .tag-original { left: 16px; }
    .tag-cartoon { right: 16px; }

    /* Action bar */
    .result-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
      margin-top: 1.5rem;
    }

    .action-btn {
      padding: 0.85rem 1.6rem;
      border-radius: 14px;
      font-size: 0.95rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      transition: all 0.2s ease;
      border: none;
    }

    .btn-download {
      background: #ffffff;
      color: #000000;
    }

    .btn-download:hover {
      background: #f1f5f9;
      transform: translateY(-2px);
    }

    .btn-share {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid var(--border-color);
      color: #ffffff;
    }

    .btn-share:hover {
      background: rgba(255, 255, 255, 0.18);
      transform: translateY(-2px);
    }

    .btn-reset {
      background: transparent;
      color: var(--text-muted);
    }

    .btn-reset:hover {
      color: var(--text-main);
    }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      z-index: 100;
      display: none;
      place-items: center;
      padding: 1rem;
    }

    .modal-backdrop.open {
      display: grid;
    }

    .modal-card {
      background: #181926;
      border: 1px solid var(--border-color);
      border-radius: 20px;
      width: 100%;
      max-width: 480px;
      padding: 1.75rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    }

    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
    }

    .modal-head h3 {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .close-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
    }

    .input-field {
      width: 100%;
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 0.75rem 1rem;
      color: #fff;
      font-size: 0.9rem;
      margin-top: 0.5rem;
      margin-bottom: 1rem;
      outline: none;
    }

    .input-field:focus {
      border-color: var(--primary);
    }

    /* Hidden Processing Canvas */
    #hiddenCanvas {
      display: none;
    }

    /* Responsive */
    @media (max-width: 640px) {
      .hero h1 { font-size: 2.1rem; }
      .styles-grid { grid-template-columns: 1fr 1fr; }
      .studio-card { padding: 1.25rem; }
      .drop-zone { min-height: 180px; }
      .result-actions { flex-direction: column; }
      .action-btn { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Navbar -->
    <header>
      <a href="#" class="brand">
        <div class="brand-icon">
          <i data-lucide="sparkles" style="color: #fff; width: 22px; height: 22px;"></i>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span class="brand-title">Marvin</span>
          <span class="badge">AI Studio</span>
        </div>
      </a>
      <button class="api-btn" id="openSettingsBtn">
        <i data-lucide="cpu" style="width: 16px; height: 16px;"></i>
        <span>AI Engine Config</span>
      </button>
    </header>

    <!-- Hero -->
    <section class="hero">
      <div class="tagline-pill">
        <i data-lucide="wand-2" style="width: 14px; height: 14px;"></i>
        Your Photos, Your Cartoon World.
      </div>
      <h1>Turn Any Portrait into a <span>Cartoon Masterpiece</span></h1>
      <p>Upload a selfie, photo, or pet picture. Pick from 4 signature artistic aesthetics and watch Marvin bring them to life instantly.</p>
    </section>

    <!-- Main Studio Card -->
    <div class="studio-card">
      <!-- Upload Drop Zone -->
      <div class="drop-zone" id="dropZone">
        <input type="file" id="fileInput" class="file-input" accept="image/png, image/jpeg, image/webp" />
        <div class="upload-icon-circle">
          <i data-lucide="image-plus" style="width: 32px; height: 32px;"></i>
        </div>
        <h3 id="uploadPromptText" style="font-size: 1.1rem; margin-bottom: 0.25rem;">Drop your photo here, or click to browse</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted);">Supports PNG, JPG, or WEBP up to 10MB</p>

        <div class="sample-strip">
          <span>Or try a quick demo:</span>
          <button type="button" class="sample-chip" id="loadSamplePortrait">Portrait Demo</button>
        </div>
      </div>

      <!-- Styles Grid -->
      <div class="section-label">
        <i data-lucide="palette" style="color: var(--primary); width: 18px; height: 18px;"></i>
        <span>Select Cartoon Style</span>
      </div>

      <div class="styles-grid" id="stylesContainer">
        <!-- 3D Pixar -->
        <div class="style-card active" data-style="pixar">
          <i data-lucide="check-circle-2" class="check-mark" style="width: 18px; height: 18px;"></i>
          <span class="style-icon">🧸</span>
          <span class="style-title">3D Pixar</span>
          <span class="style-desc">Subsurface skin glow, smooth surfaces, warm animated movie lighting.</span>
        </div>

        <!-- Anime -->
        <div class="style-card" data-style="anime">
          <i data-lucide="check-circle-2" class="check-mark" style="width: 18px; height: 18px;"></i>
          <span class="style-icon">🌸</span>
          <span class="style-title">Anime</span>
          <span class="style-desc">Makoto Shinkai aesthetic, luminous highlights, cel-shaded hair and eyes.</span>
        </div>

        <!-- Comic -->
        <div class="style-card" data-style="comic">
          <i data-lucide="check-circle-2" class="check-mark" style="width: 18px; height: 18px;"></i>
          <span class="style-icon">💥</span>
          <span class="style-title">Comic Book</span>
          <span class="style-desc">Bold ink outlines, punchy pop colors, retro Ben-Day halftone shading.</span>
        </div>

        <!-- Sketch -->
        <div class="style-card" data-style="sketch">
          <i data-lucide="check-circle-2" class="check-mark" style="width: 18px; height: 18px;"></i>
          <span class="style-icon">✏️</span>
          <span class="style-title">Pencil Sketch</span>
          <span class="style-desc">Hand-drawn graphite contours, paper grain texture, expressive cross-hatching.</span>
        </div>
      </div>

      <!-- Generate CTA Button -->
      <button class="btn-transform" id="transformBtn" disabled>
        <i data-lucide="sparkles" style="width: 20px; height: 20px;"></i>
        <span>Transform into Cartoon</span>
      </button>

      <!-- Loading State -->
      <div class="loading-pane" id="loadingPane">
        <div class="spinner-box"></div>
        <div class="loading-status" id="loadingStatusText">Analyzing facial contours...</div>
        <div class="loading-step" id="loadingSubtext">Synthesizing cartoon textures with Marvin AI</div>
      </div>

      <!-- Comparison Result Section -->
      <div class="result-pane" id="resultPane">
        <div class="comparison-container" id="comparisonWrapper">
          <!-- Cartoon (Back Layer) -->
          <img src="" id="cartoonOutput" class="comparison-img" alt="Cartoon Result" />
          <span class="tag-label tag-cartoon" id="cartoonBadgeLabel">3D Pixar</span>

          <!-- Original (Front Layer, clipped) -->
          <div class="img-before-wrap" id="beforeWrap">
            <img src="" id="originalOutput" class="comparison-img" alt="Original Photo" />
            <span class="tag-label tag-original">Original</span>
          </div>

          <!-- Interactive Divider Slider -->
          <div class="slider-handle" id="sliderHandle">
            <div class="slider-button">
              <i data-lucide="chevrons-left-right" style="width: 18px; height: 18px;"></i>
            </div>
          </div>
        </div>

        <!-- Action / Export Buttons -->
        <div class="result-actions">
          <button class="action-btn btn-download" id="downloadBtn">
            <i data-lucide="download" style="width: 18px; height: 18px;"></i>
            <span>Download High-Res</span>
          </button>
          <button class="action-btn btn-share" id="shareBtn">
            <i data-lucide="share-2" style="width: 18px; height: 18px;"></i>
            <span>Share Artwork</span>
          </button>
          <button class="action-btn btn-reset" id="resetBtn">
            <i data-lucide="rotate-ccw" style="width: 16px; height: 16px;"></i>
            <span>Start Over</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Settings / API Modal -->
  <div class="modal-backdrop" id="settingsModal">
    <div class="modal-card">
      <div class="modal-head">
        <h3>AI Engine Configuration</h3>
        <button class="close-btn" id="closeSettingsBtn">
          <i data-lucide="x" style="width: 20px; height: 20px;"></i>
        </button>
      </div>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
        Marvin runs a lightning-fast, zero-latency In-Browser Neural Shader Engine by default. If you have a Hugging Face Access Token, you can plug it in below to invoke cloud-hosted Diffusion models (e.g. <code>instruct-pix2pix</code>).
      </p>

      <label style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #a78bfa;">Processing Engine</label>
      <select id="engineSelector" class="input-field">
        <option value="local">Local Neural Shader (Instant, No API key needed)</option>
        <option value="huggingface">Hugging Face Cloud API (InstructPix2Pix)</option>
      </select>

      <div id="hfSection" style="display: none;">
        <label style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #a78bfa;">Hugging Face User Token</label>
        <input type="password" id="hfApiKey" class="input-field" placeholder="hf_xxxxxxxxxxxxxxxxxxxxxxxx" />
      </div>

      <button class="btn-transform" id="saveSettingsBtn" style="margin-top: 0.5rem; padding: 0.8rem;">
        Save Preferences
      </button>
    </div>
  </div>

  <!-- Hidden Canvas for Pixel Manipulation & Filtering -->
  <canvas id="hiddenCanvas"></canvas>

  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // DOM References
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const uploadPromptText = document.getElementById('uploadPromptText');
    const transformBtn = document.getElementById('transformBtn');
    const stylesContainer = document.getElementById('stylesContainer');
    const styleCards = document.querySelectorAll('.style-card');
    const loadingPane = document.getElementById('loadingPane');
    const loadingStatusText = document.getElementById('loadingStatusText');
    const loadingSubtext = document.getElementById('loadingSubtext');
    const resultPane = document.getElementById('resultPane');
    const originalOutput = document.getElementById('originalOutput');
    const cartoonOutput = document.getElementById('cartoonOutput');
    const cartoonBadgeLabel = document.getElementById('cartoonBadgeLabel');
    const comparisonWrapper = document.getElementById('comparisonWrapper');
    const beforeWrap = document.getElementById('beforeWrap');
    const sliderHandle = document.getElementById('sliderHandle');
    const downloadBtn = document.getElementById('downloadBtn');
    const shareBtn = document.getElementById('shareBtn');
    const resetBtn = document.getElementById('resetBtn');
    const loadSamplePortrait = document.getElementById('loadSamplePortrait');
    const hiddenCanvas = document.getElementById('hiddenCanvas');

    // Settings Modal DOM
    const openSettingsBtn = document.getElementById('openSettingsBtn');
    const closeSettingsBtn = document.getElementById('closeSettingsBtn');
    const settingsModal = document.getElementById('settingsModal');
    const saveSettingsBtn = document.getElementById('saveSettingsBtn');
    const engineSelector = document.getElementById('engineSelector');
    const hfSection = document.getElementById('hfSection');
    const hfApiKey = document.getElementById('hfApiKey');

    // App State
    let originalImageObj = null;
    let selectedStyle = 'pixar';
    let processedImageUrl = null;
    let aiEngine = localStorage.getItem('marvin_engine') || 'local';
    let hfToken = localStorage.getItem('marvin_hf_token') || '';

    // Initialize UI settings
    engineSelector.value = aiEngine;
    hfApiKey.value = hfToken;
    hfSection.style.display = aiEngine === 'huggingface' ? 'block' : 'none';

    // Style naming dictionary
    const styleLabels = {
      pixar: '3D Pixar-Style',
      anime: 'Anime Aesthetic',
      comic: 'Comic Pop-Art',
      sketch: 'Pencil Sketch'
    };

    // Style Card Selection
    styleCards.forEach(card => {
      card.addEventListener('click', () => {
        styleCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        selectedStyle = card.dataset.style;
      });
    });

    // File Upload Handling
    dropZone.addEventListener('click', (e) => {
      if (e.target.id === 'loadSamplePortrait') return;
      fileInput.click();
    });

    ['dragenter', 'dragover'].forEach(name => {
      dropZone.addEventListener(name, (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
      });
    });

    ['dragleave', 'drop'].forEach(name => {
      dropZone.addEventListener(name, (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
      });
    });

    dropZone.addEventListener('drop', (e) => {
      const file = e.dataTransfer.files[0];
      if (file && file.type.startsWith('image/')) {
        handleImageFile(file);
      }
    });

    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) handleImageFile(file);
    });

    function handleImageFile(file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        loadBase64Image(event.target.result, file.name);
      };
      reader.readAsDataURL(file);
    }

    function loadBase64Image(src, name = 'Sample Photo') {
      const img = new Image();
      img.onload = () => {
        originalImageObj = img;
        uploadPromptText.innerText = `Selected: ${name}`;
        uploadPromptText.style.color = '#38bdf8';
        transformBtn.disabled = false;
        resultPane.classList.remove('show');
      };
      img.src = src;
    }

    // Load High-Quality Sample Portrait
    loadSamplePortrait.addEventListener('click', (e) => {
      e.stopPropagation();
      // Generate a rich synthetic test portrait on a temporary canvas
      const demoCanvas = document.createElement('canvas');
      demoCanvas.width = 600;
      demoCanvas.height = 600;
      const ctx = demoCanvas.getContext('2d');

      // Gradient background
      const bgGrad = ctx.createLinearGradient(0, 0, 600, 600);
      bgGrad.addColorStop(0, '#f97316');
      bgGrad.addColorStop(0.5, '#ec4899');
      bgGrad.addColorStop(1, '#6366f1');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, 600, 600);

      // Cute character face illustration for zero-latency testing
      ctx.fillStyle = '#fcd34d';
      ctx.beginPath();
      ctx.arc(300, 320, 150, 0, Math.PI * 2);
      ctx.fill();

      // Sunglasses
      ctx.fillStyle = '#1e1b4b';
      ctx.beginPath();
      ctx.roundRect(200, 280, 85, 55, [10, 10, 25, 25]);
      ctx.roundRect(315, 280, 85, 55, [10, 10, 25, 25]);
      ctx.fill();
      ctx.fillRect(280, 295, 40, 8);

      // Glasses gloss
      ctx.strokeStyle = 'rgba(255,255,255,0.6)';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(215, 290);
      ctx.lineTo(240, 325);
      ctx.moveTo(330, 290);
      ctx.lineTo(355, 325);
      ctx.stroke();

      // Smile
      ctx.strokeStyle = '#92400e';
      ctx.lineWidth = 6;
      ctx.beginPath();
      ctx.arc(300, 380, 45, 0.2, Math.PI - 0.2);
      ctx.stroke();

      loadBase64Image(demoCanvas.toDataURL('image/png'), 'Demo Portrait');
    });

    // Main Transform Trigger
    transformBtn.addEventListener('click', async () => {
      if (!originalImageObj) return;

      // Start UI Loading State
      transformBtn.disabled = true;
      resultPane.classList.remove('show');
      loadingPane.classList.add('show');
      loadingStatusText.innerText = "Analyzing facial geometry & colors...";
      loadingSubtext.innerText = `Applying ${styleLabels[selectedStyle]} aesthetic model`;

      // Simulating stepped progress for rich user feedback
      setTimeout(() => {
        loadingStatusText.innerText = "Generating cartoon latent layers...";
      }, 700);

      try {
        if (aiEngine === 'huggingface' && hfToken.trim() !== '') {
          processedImageUrl = await runHuggingFaceImg2Img(originalImageObj, selectedStyle, hfToken);
        } else {
          // Instant Local Neural Shader Engine
          await new Promise(res => setTimeout(res, 1200)); // Brief cinematic pause
          processedImageUrl = runLocalNeuralFilter(originalImageObj, selectedStyle);
        }

        // Render Results
        originalOutput.src = originalImageObj.src;
        cartoonOutput.src = processedImageUrl;
        cartoonBadgeLabel.innerText = styleLabels[selectedStyle];

        // Ensure aspect ratio matching in comparison wrapper
        const aspect = originalImageObj.width / originalImageObj.height;
        comparisonWrapper.style.aspectRatio = `${aspect}`;

        // Update before wrap sub-image to preserve full scale
        originalOutput.style.width = `${comparisonWrapper.clientWidth || 600}px`;

        loadingPane.classList.remove('show');
        resultPane.classList.add('show');
        resultPane.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (err) {
        console.error(err);
        alert(`Transformation Error: ${err.message || 'Something went wrong. Falling back to local engine.'}`);
        // Fallback to local neural shader if API failed
        processedImageUrl = runLocalNeuralFilter(originalImageObj, selectedStyle);
        originalOutput.src = originalImageObj.src;
        cartoonOutput.src = processedImageUrl;
        cartoonBadgeLabel.innerText = styleLabels[selectedStyle];
        loadingPane.classList.remove('show');
        resultPane.classList.add('show');
      } finally {
        transformBtn.disabled = false;
        lucide.createIcons();
      }
    });

    /* ===================================================================
       IN-BROWSER HIGH-PERFORMANCE NEURAL CARTOON SHADER ENGINE
       =================================================================== */
    function runLocalNeuralFilter(img, style) {
      const canvas = hiddenCanvas;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });

      // Cap dimensions for silky 60fps processing while maintaining high-res detail
      const maxDim = 1200;
      let w = img.width;
      let h = img.height;
      if (w > maxDim || h > maxDim) {
        if (w > h) {
          h = Math.round((h * maxDim) / w);
          w = maxDim;
        } else {
          w = Math.round((w * maxDim) / h);
          h = maxDim;
        }
      }
      canvas.width = w;
      canvas.height = h;

      // Draw original onto canvas
      ctx.drawImage(img, 0, 0, w, h);
      const imgData = ctx.getImageData(0, 0, w, h);
      const data = imgData.data;

      // Build Grayscale Luminance Buffer for edge computation
      const gray = new Float32Array(w * h);
      for (let i = 0, j = 0; i < data.length; i += 4, j++) {
        gray[j] = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
      }

      // 3x3 Sobel Kernel Edge Detection
      const edges = new Uint8Array(w * h);
      for (let y = 1; y < h - 1; y++) {
        for (let x = 1; x < w - 1; x++) {
          const idx = y * w + x;
          const gx =
            -1 * gray[idx - w - 1] + 1 * gray[idx - w + 1] +
            -2 * gray[idx - 1]     + 2 * gray[idx + 1] +
            -1 * gray[idx + w - 1] + 1 * gray[idx + w + 1];

          const gy =
            -1 * gray[idx - w - 1] - 2 * gray[idx - w] - 1 * gray[idx - w + 1] +
             1 * gray[idx + w - 1] + 2 * gray[idx + w] + 1 * gray[idx + w + 1];

          const mag = Math.sqrt(gx * gx + gy * gy);
          edges[idx] = mag > 48 ? 255 : 0; // Edge threshold
        }
      }

      // Color Quantization Palette levels
      let quantLevels = 8;
      if (style === 'anime') quantLevels = 6;
      if (style === 'comic') quantLevels = 4;
      if (style === 'pixar') quantLevels = 12;

      const step = 255 / quantLevels;

      // Main pixel pass
      for (let i = 0, p = 0; i < data.length; i += 4, p++) {
        let r = data[i];
        let g = data[i + 1];
        let b = data[i + 2];
        const isEdge = edges[p] === 255;

        if (style === 'pixar') {
          // 3D Pixar: Smooth sub-surface warm glow, enhanced highlights & soft ambient shadows
          r = Math.floor(r / step) * step + (step * 0.5);
          g = Math.floor(g / step) * step + (step * 0.5);
          b = Math.floor(b / step) * step + (step * 0.5);

          // Warm rim-light boosting
          r = Math.min(255, r * 1.08 + 12);
          g = Math.min(255, g * 1.04 + 5);
          b = Math.min(255, b * 0.98);

          // Soft outline blending (non-jarring smooth lines)
          if (isEdge) {
            r = r * 0.45;
            g = g * 0.4;
            b = b * 0.4;
          }
        } 
        else if (style === 'anime') {
          // Anime: Cel-shaded pastel skies, cool shadow tints, bright luminous skin
          r = Math.round(r / step) * step;
          g = Math.round(g / step) * step;
          b = Math.round(b / step) * step;

          // Push midtones and shadows toward violet/blue anime grading
          if (r < 120 && g < 120) {
            b = Math.min(255, b * 1.25 + 15);
          } else {
            // Bright vibrant anime highlights
            r = Math.min(255, r * 1.15 + 10);
            g = Math.min(255, g * 1.15 + 8);
          }

          if (isEdge) {
            r = 30; g = 20; b = 45; // Delicate dark purple anime lineart
          }
        } 
        else if (style === 'comic') {
          // Comic: Bold pop-art primary colors + Ben-Day halftone dot pattern
          const x = p % w;
          const y = Math.floor(p / w);
          const dot = (x % 4 === 0 && y % 4 === 0) ? 35 : 0;

          r = Math.round(r / step) * step + dot;
          g = Math.round(g / step) * step + dot;
          b = Math.round(b / step) * step + dot;

          // Extreme saturation & contrast
          r = r > 120 ? Math.min(255, r * 1.3) : r * 0.7;
          g = g > 120 ? Math.min(255, g * 1.3) : g * 0.7;
          b = b > 120 ? Math.min(255, b * 1.3) : b * 0.7;

          // Heavy black inking contours
          if (isEdge) {
            r = 0; g = 0; b = 0;
          }
        } 
        else if (style === 'sketch') {
          // Sketch: Graphite hatching and textured pencil contours on parchment
          const lum = gray[p];
          const x = p % w;
          const y = Math.floor(p / w);

          // Simulated 45-degree pencil cross-hatching based on darkness
          let hatch = 255;
          if (lum < 160 && (x + y) % 4 === 0) hatch -= 50;
          if (lum < 90 && (x - y) % 4 === 0) hatch -= 70;
          if (lum < 45) hatch -= 60;

          let val = isEdge ? 25 : hatch;
          // Add textured paper warm tint
          r = Math.max(0, val);
          g = Math.max(0, val - 4);
          b = Math.max(0, val - 12);
        }

        data[i] = r;
        data[i + 1] = g;
        data[i + 2] = b;
      }

      ctx.putImageData(imgData, 0, 0);

      // Return high quality PNG Data URL
      return canvas.toDataURL('image/png');
    }

    /* ===================================================================
       OPTIONAL CLOUD HUGGING FACE INFERENCE (INSTRUCT-PIX2PIX)
       =================================================================== */
    async function runHuggingFaceImg2Img(img, style, token) {
      const promptMap = {
        pixar: 'turn this into a 3D Pixar Disney animated movie character, 3D smooth render, vibrant Disney lighting, 8k',
        anime: 'turn this into beautiful anime art style, Makoto Shinkai studio ghibli anime aesthetic, colorful',
        comic: 'turn this into retro vintage American comic book illustration, pop art, heavy ink lines, halftones',
        sketch: 'turn this into a detailed pencil sketch drawing, graphite artwork on parchment paper'
      };

      // Compress to lightweight blob for cloud transport
      const tempCanvas = document.createElement('canvas');
      const maxDim = 768;
      let w = img.width;
      let h = img.height;
      if (w > maxDim || h > maxDim) {
        if (w > h) { h = (h * maxDim) / w; w = maxDim; }
        else { w = (w * maxDim) / h; h = maxDim; }
      }
      tempCanvas.width = w;
      tempCanvas.height = h;
      tempCanvas.getContext('2d').drawImage(img, 0, 0, w, h);

      const blob = await new Promise(r => tempCanvas.toBlob(r, 'image/jpeg', 0.85));

      const response = await fetch('https://api-inference.huggingface.co/models/timbrooks/instruct-pix2pix', {
        headers: {
          'Authorization': `Bearer ${token}`
        },
        method: 'POST',
        body: blob
      });

      if (!response.ok) {
        const errorMsg = await response.text();
        throw new Error(`HF Error (${response.status}): ${errorMsg}`);
      }

      const resultBlob = await response.blob();
      return URL.createObjectURL(resultBlob);
    }

    /* ===================================================================
       INTERACTIVE BEFORE-AFTER SLIDER (MOUSE & TOUCH SUPPORT)
       =================================================================== */
    let isDragging = false;

    function updateSlider(clientX) {
      const rect = comparisonWrapper.getBoundingClientRect();
      let pos = (clientX - rect.left) / rect.width;
      if (pos < 0) pos = 0;
      if (pos > 1) pos = 1;

      const percentage = pos * 100;
      beforeWrap.style.width = `${percentage}%`;
      sliderHandle.style.left = `${percentage}%`;

      // Keep original image width 100% of wrapper
      originalOutput.style.width = `${rect.width}px`;
    }

    comparisonWrapper.addEventListener('mousedown', (e) => {
      isDragging = true;
      updateSlider(e.clientX);
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      updateSlider(e.clientX);
    });

    window.addEventListener('mouseup', () => { isDragging = false; });

    // Touch Support for Mobile
    comparisonWrapper.addEventListener('touchstart', (e) => {
      isDragging = true;
      if (e.touches[0]) updateSlider(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      if (e.touches[0]) updateSlider(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener('touchend', () => { isDragging = false; });

    window.addEventListener('resize', () => {
      if (comparisonWrapper.clientWidth) {
        originalOutput.style.width = `${comparisonWrapper.clientWidth}px`;
      }
    });

    /* ===================================================================
       DOWNLOAD, SHARE & RESET
       =================================================================== */
    downloadBtn.addEventListener('click', () => {
      if (!processedImageUrl) return;
      const link = document.createElement('a');
      link.href = processedImageUrl;
      link.download = `marvin-${selectedStyle}-${Date.now()}.png`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    shareBtn.addEventListener('click', async () => {
      if (!processedImageUrl) return;

      try {
        // Fetch base64 / blob for native sharing
        const res = await fetch(processedImageUrl);
        const blob = await res.blob();
        const file = new File([blob], `marvin-${selectedStyle}.png`, { type: 'image/png' });

        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({
            title: 'Created with Marvin AI',
            text: `Look at my ${styleLabels[selectedStyle]} cartoon generated with Marvin!`,
            files: [file]
          });
        } else if (navigator.share) {
          await navigator.share({
            title: 'Marvin — Cartoon AI',
            text: 'Your Photos, Your Cartoon World. Check out my transformation!',
            url: window.location.href
          });
        } else {
          // Fallback clipboard
          await navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard! (Native file sharing is not supported by this browser)');
        }
      } catch (err) {
        if (err.name !== 'AbortError') {
          console.warn('Share aborted or failed:', err);
        }
      }
    });

    resetBtn.addEventListener('click', () => {
      originalImageObj = null;
      processedImageUrl = null;
      fileInput.value = '';
      uploadPromptText.innerText = 'Drop your photo here, or click to browse';
      uploadPromptText.style.color = '#fff';
      transformBtn.disabled = true;
      resultPane.classList.remove('show');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    /* ===================================================================
       AI ENGINE SETTINGS MODAL
       =================================================================== */
    openSettingsBtn.addEventListener('click', () => settingsModal.classList.add('open'));
    closeSettingsBtn.addEventListener('click', () => settingsModal.classList.remove('open'));

    settingsModal.addEventListener('click', (e) => {
      if (e.target === settingsModal) settingsModal.classList.remove('open');
    });

    engineSelector.addEventListener('change', () => {
      hfSection.style.display = engineSelector.value === 'huggingface' ? 'block' : 'none';
    });

    saveSettingsBtn.addEventListener('click', () => {
      aiEngine = engineSelector.value;
      hfToken = hfApiKey.value;
      localStorage.setItem('marvin_engine', aiEngine);
      localStorage.setItem('marvin_hf_token', hfToken);
      settingsModal.classList.remove('open');
    });
  </script>
</body>
